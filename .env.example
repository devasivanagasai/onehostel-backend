# Copy this file to .env (git-ignored) and fill in the values. Never commit .env.
# Read by infra/local/start-local.ps1, infra/local/docker-compose.yml and every service
# (each application.yml imports .env from the repo root).

# Keycloak admin console account, created on Keycloak's first start
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Secret of the confidential Keycloak client "oh-auth-gtwy-service"
# (used by onehostel-access-core for OTP login and password reset). Any long random string.
KEYCLOAK_SERVICE_CLIENT_SECRET=

# Initial password of the seeded super.admin account (applied when the realm is first imported).
# Must meet the password policy: 8-128 chars, upper + lower case, digit, special character, no spaces.
SUPERADMIN_PASSWORD=

# Shared by the gateway (sends it) and every service (checks it), so identity headers cannot be forged
# by calling a service directly. Any long random string. Optional under the local profile only.
GATEWAY_INTERNAL_SECRET=

# MongoDB Atlas. Leave the four *_MONGODB_URI lines out to use a local MongoDB instead
# (mongodb://localhost:27017/onehostel_<service>). The password goes inside a connection string, so
# URL-encode its special characters ('@' -> %40, ':' -> %3A, '/' -> %2F, '#' -> %23, '%' -> %25).
MONGODB_ATLAS_USER=onehostel_admin
MONGODB_ATLAS_PASSWORD=<url-encoded db password>
MONGODB_ATLAS_HOST=onehostel-cluster.8vqprtf.mongodb.net
ACCESS_MONGODB_URI=mongodb+srv://${MONGODB_ATLAS_USER}:${MONGODB_ATLAS_PASSWORD}@${MONGODB_ATLAS_HOST}/onehostel_access?appName=onehostel
RESIDENT_MONGODB_URI=mongodb+srv://${MONGODB_ATLAS_USER}:${MONGODB_ATLAS_PASSWORD}@${MONGODB_ATLAS_HOST}/onehostel_resident?appName=onehostel
PROPERTY_MONGODB_URI=mongodb+srv://${MONGODB_ATLAS_USER}:${MONGODB_ATLAS_PASSWORD}@${MONGODB_ATLAS_HOST}/onehostel_property?appName=onehostel
BILLING_MONGODB_URI=mongodb+srv://${MONGODB_ATLAS_USER}:${MONGODB_ATLAS_PASSWORD}@${MONGODB_ATLAS_HOST}/onehostel_billing?appName=onehostel

# Optional overrides (defaults shown)
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# AUTH_RATE_LIMIT_PER_MINUTE=10
