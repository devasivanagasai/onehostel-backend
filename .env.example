# Copy this file to .env (git-ignored) and fill in the values. Never commit .env.
# Read by infra/local/start-local.ps1, infra/local/docker-compose.yml and oh-auth-gtwy
# (application.yml imports .env from the repo root).

# Keycloak admin console account, created on Keycloak's first start
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Secret of the confidential Keycloak client "oh-auth-gtwy-service"
# (used by the gateway for OTP login and password reset). Any long random string.
KEYCLOAK_SERVICE_CLIENT_SECRET=

# Initial password of the seeded super.admin account (applied when the realm is first imported).
# Must meet the password policy: 8-128 chars, upper + lower case, digit, special character, no spaces.
SUPERADMIN_PASSWORD=
